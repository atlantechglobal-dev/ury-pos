  "format_data": null,
  "html": "\n<style>\n  @page { size: 80mm auto; margin: 0mm; }\n  * { box-sizing: border-box; }\n</style>\n\n<div style=\"font-family: 'Courier New', Courier, monospace; font-size: 14px; font-weight: 600; width: 100%; padding: 0 3mm;\">\n  <div style=\"text-align:center;\">\n    <div style=\"font-size:16px; font-weight:bold;\">Arabian Mandi</div>\n    <div>Ancient Eateries PVT LTD</div>\n    <div>Opposite of Kausar Baug Masjid, Gate No.02, Galaxy Premium,<br>Shop No.01, Kondhwa, Pune MH - 411048</div>\n    <div>Contact No. 7558300932</div>\n  </div>\n\n  <div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n  <div>Name: {{ doc.customer_name if doc.customer_name and doc.customer_name != \"Walk-in Customer\" else \"\" }}</div>\n\n  <div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n  <table style=\"width:100%;\">\n    <tr>\n      <td style=\"vertical-align:top;\">\n        Date: {{ frappe.utils.formatdate(doc.posting_date, \"dd/MM/yy\") }}<br>\n        {{ (doc.posting_time|string)[:5] }}\n      </td>\n      <td style=\"text-align:right; vertical-align:top; font-weight:bold;\">\n        {% if doc.order_type == 'Dine In' or not doc.order_type %}\n          Dine In{% if doc.restaurant_table %}: {{ doc.restaurant_table }}{% endif %}\n        {% else %}\n          {{ doc.order_type }}\n        {% endif %}\n      </td>\n    </tr>\n  </table>\n\n  <div>Cashier: {{ doc.cashier or doc.owner }} &nbsp;&nbsp; Bill No.: {{ doc.custom_ury_order_number or doc.name }}</div>\n\n  <div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n  <table style=\"width:100%; border-collapse:collapse; table-layout:fixed;\">\n    <colgroup>\n      <col style=\"width:36%;\">\n      <col style=\"width:12%;\">\n      <col style=\"width:26%;\">\n      <col style=\"width:26%;\">\n    </colgroup>\n    <tr style=\"border-bottom:1px solid #000;\">\n      <th style=\"text-align:left; padding-bottom:4px; vertical-align:top;\">Item</th>\n      <th style=\"text-align:center; padding-bottom:4px; vertical-align:top;\">Qty.</th>\n      <th style=\"text-align:right; padding:0 6px 4px 0; vertical-align:top;\">Price</th>\n      <th style=\"text-align:right; padding-bottom:4px; vertical-align:top;\">Amount</th>\n    </tr>\n    {% for item in doc.items %}\n    <tr>\n      <td style=\"padding:3px 4px 3px 0; vertical-align:top; word-break:break-word; font-size:12.5px;\">{{ item.item_name }}</td>\n      <td style=\"text-align:center; padding:3px 4px; vertical-align:top; font-size:12.5px;\">{{ item.qty|int }}</td>\n      <td style=\"text-align:right; padding:3px 6px 3px 0; vertical-align:top; font-size:12.5px;\">{{ \"%.2f\"|format(item.rate) }}</td>\n      <td style=\"text-align:right; padding:3px 0 3px 4px; vertical-align:top; font-size:12.5px;\">{{ \"%.2f\"|format(item.amount) }}</td>\n    </tr>\n    {% endfor %}\n  </table>\n\n  <div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n  <table style=\"width:100%;\">\n    <tr>\n      <td>Total Qty: {{ doc.items|sum(attribute='qty')|int }}</td>\n      <td style=\"text-align:right;\">Sub Total &nbsp; {{ \"%.2f\"|format(doc.total) }}</td>\n    </tr>\n    {% if doc.additional_discount_percentage %}\n    <tr>\n      <td></td>\n      <td style=\"text-align:right;\">\n        Discount ({{ \"%.2f\"|format(doc.additional_discount_percentage) }}%) &nbsp; -{{ \"%.2f\"|format(doc.discount_amount) }}\n      </td>\n    </tr>\n    {% endif %}\n  </table>\n\n  <div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n  <div style=\"text-align:center; font-size:15px; font-weight:bold;\">\n    Grand Total &#8377; {{ \"%.2f\"|format(doc.grand_total) }}\n  </div>\n\n  <div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n  <div style=\"text-align:center;\">\n    For Bulk Orders and Cattering<br>\n    Please Contact 7558300932.\n    <br><br>\n    <b>THANK YOU VISIT AGAIN !!!</b>\n  </div>\n</div>\n",
