  "html": "\n<style>\n  @page { size: 80mm auto; margin: 0mm; }\n  * { box-sizing: border-box; }\n</style>\n\n<div style=\"font-family: 'Courier New', Courier, monospace; font-size: 15px; font-weight: 600; width: 100%; padding: 0 3mm; text-align:center;\">\n  <div style=\"font-size:15px; font-weight:bold;\">\n    {% if doc.type == 'Order Modified' %}Running Table{% else %}New Order{% endif %}\n  </div>\n  <div>{{ frappe.utils.formatdate(doc.date, \"dd/MM/yy\") }} {{ (doc.time|string)[:5] }}</div>\n  <div style=\"font-weight:bold;\">KOT - {{ doc.order_no or doc.name }}</div>\n  <div style=\"font-weight:bold;\">{% if doc.table_takeaway %}Take Away{% else %}Dine In{% endif %}</div>\n  <div style=\"font-weight:bold;\">Table No: {{ doc.restaurant_table }}</div>\n  <div style=\"font-weight:bold;\">Waiter Name: {{ frappe.db.get_value(\"POS Invoice\", doc.invoice, \"waiter\") or \"\" }}</div>\n</div>\n\n<div style=\"border-top:1px dashed #000; margin:6px 0;\"></div>\n\n<table style=\"width:100%; padding:0 3mm; border-collapse:collapse; table-layout:fixed; font-family: 'Courier New', Courier, monospace; font-size: 15px; font-weight: 600;\">\n  <colgroup>\n    <col style=\"width:40%;\">\n    <col style=\"width:40%;\">\n    <col style=\"width:20%;\">\n  </colgroup>\n  <tr style=\"border-bottom:1px dashed #000;\">\n    <th style=\"text-align:left; padding-bottom:4px; vertical-align:top;\">Item</th>\n    <th style=\"text-align:left; padding-bottom:4px; vertical-align:top;\">Special Note</th>\n    <th style=\"text-align:right; padding-bottom:4px; vertical-align:top;\">Qty.</th>\n  </tr>\n  {% for row in doc.kot_items %}\n  <tr>\n    <td style=\"padding:3px 4px 3px 0; vertical-align:top; word-break:break-word;\">{{ row.item_name }}</td>\n    <td style=\"padding:3px 4px; vertical-align:top; word-break:break-word;\">{% if row.comments %}[Note] {{ row.comments }}{% endif %}</td>\n    <td style=\"text-align:right; padding:3px 0 3px 4px; vertical-align:top;\">{{ row.quantity }}</td>\n  </tr>\n  {% endfor %}\n</table>\n",
